# Fournisseur de LLM : "gemini" (cloud, gratuit) ou "anthropic" (Claude, payant)
LLM_PROVIDER=gemini

# --- Gemini (gratuit via Google AI Studio) ---
# Crée une clé gratuite sur https://aistudio.google.com/apikey
# Offre gratuite : Google peut utiliser et faire relire les contenus envoyés (hors EEE/Suisse/R.-U.).
# N'y envoie pas de vrais CV de candidats.
GEMINI_API_KEY=
# Autre choix gratuit, plus précis mais plus lent : gemini-3.6-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic (seulement si LLM_PROVIDER=anthropic) ---
# Clé API : https://platform.claude.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

PORT=3043
