# LLM provider: "gemini" (Google, free tier) or "anthropic" (Claude, paid)
LLM_PROVIDER=gemini

# API key of the chosen provider:
#   - gemini:    free key at https://aistudio.google.com/apikey
#   - anthropic: https://platform.claude.com
LLM_API_KEY=

# Model of the chosen provider (optional: each provider has a default if empty):
#   - gemini:    gemini-3.5-flash-lite (default), gemini-3.6-flash (more accurate, slower)
#   - anthropic: claude-haiku-5-5 (default)
LLM_MODEL=gemini-3.5-flash-lite

# Gemini free tier: Google may use and have humans review submitted content
# (outside the EEA/Switzerland/UK). Do not send real candidates' resumes.

PORT=3043
